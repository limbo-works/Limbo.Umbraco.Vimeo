{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$defs": {
		"VimeoSettings": {
			"type": "object",
			"description": "Configuration for Limbo Umbraco Vimeo.",
			"properties": {
				"Credentials": {
					"type": "array",
					"description": "The credentials configured for accessing the Vimeo API.",
					"items": {
						"$ref": "#/$defs/VimeoCredentials"
					},
					"default": []
				}
			},
			"additionalProperties": false
		},
		"VimeoCredentials": {
			"type": "object",
			"description": "Credentials used for accessing the Vimeo API.",
			"properties": {
				"Key": {
					"type": "string",
					"format": "uuid",
					"description": "The unique key of the credentials."
				},
				"Name": {
					"type": "string",
					"minLength": 1,
					"description": "The friendly name of the credentials."
				},
				"Description": {
					"type": "string",
					"description": "An optional description of the credentials."
				},
				"AccessToken": {
					"type": "string",
					"minLength": 1,
					"description": "The Vimeo access token."
				}
			},
			"required": [
				"Key",
				"Name",
				"AccessToken"
			],
			"additionalProperties": false
		}
	},
	"type": "object",
	"properties": {
		"Limbo": {
			"type": "object",
			"properties": {
				"Vimeo": {
					"$ref": "#/$defs/VimeoSettings"
				}
			}
		}
	}
}